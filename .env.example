# Copia este archivo como `.env` y rellena lo que vayas a usar. Nada de aquí
# llega al navegador: los endpoints de `api/` son los únicos que lo leen.
#
# Vite sólo expone al cliente las variables `VITE_*`, y a propósito no hay
# ninguna: ni el `client_id` de Notion ni ninguna clave tienen que estar en el
# paquete que se descarga.

# --- Notion (Fase 1) ------------------------------------------------------
# De la integración pública que crees en notion.so/my-integrations. El secreto
# no sale del servidor: el canje del `code` por el token pasa por
# `api/notion-oauth.ts`, nunca por el navegador.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# La misma URL, carácter por carácter, que hayas puesto en la integración. Notion
# exige que la de autorizar y la de canjear el código sean idénticas, y aquí sale
# la única fuente de las dos.
#   en local      http://localhost:5173
#   desplegado    la URL del despliegue (https://tu-proyecto.pages.dev)
# Las dos tienen que estar registradas en la integración; en cada entorno va la
# suya. Con la de local puesta en producción, Notion rechaza el canje.
NOTION_OAUTH_REDIRECT_URI=

# --- IA (Fase 5) ----------------------------------------------------------
# Opcionales. Si pones una clave aquí, la pestaña IA no la pide: dice que el
# servidor ya la tiene y nunca revela cuál es. Si no pones ninguna, cada
# persona pega la suya en la pestaña IA y se queda en su navegador.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Un token de GitHub con acceso a Copilot o a GitHub Models. Sin esto, el alta
# por dispositivo sigue funcionando: cada persona conecta su propia cuenta.
GITHUB_AI_TOKEN=

# Sólo si despliegas con tu propia aplicación de GitHub. Por omisión se usa el
# `client_id` público de Copilot, que es el que usan opencode y la CLI oficial.
GITHUB_CLIENT_ID=

# --- Proveedores propios --------------------------------------------------
# La pestaña IA permite añadir cualquier API que hable el formato de OpenAI
# («＋ Otro»): un nombre, la URL base y su clave. Esto decide hasta dónde llega
# el servidor al llamarlas:
#   public  sólo https y direcciones públicas (redes internas bloqueadas)
#   local   además, http y direcciones de la máquina: Ollama, LM Studio
#   off     no se admiten proveedores propios
# Sin poner nada: `local` en desarrollo y `public` desplegado.
AI_CUSTOM_PROVIDERS=

# --- Registro de modelos --------------------------------------------------
# El catálogo se pide a cada proveedor en cada consulta; el registro público de
# models.dev sólo completa lo que falte (contexto, precio, si razona) y sirve de
# respaldo cuando una API no tiene `/models`. Aquí no hay ninguna lista que
# mantener a mano.
# Otra dirección del registro, si tienes un espejo.
AI_MODELS_URL=
# `1` para no consultarlo: los modelos saldrán tal cual los dé el proveedor.
AI_MODELS_OFF=
